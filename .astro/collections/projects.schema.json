{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 99,
      "type": "number"
    },
    "subtitle": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "format": "uri"
    },
    "demo": {
      "type": "string",
      "format": "uri"
    },
    "stack": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "default": "placeholder",
            "type": "string",
            "enum": [
              "screenshot",
              "video",
              "diagram",
              "placeholder"
            ]
          },
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "status": {
            "default": "planned",
            "type": "string",
            "enum": [
              "available",
              "planned"
            ]
          }
        },
        "required": [
          "title",
          "caption"
        ]
      }
    },
    "demoLinks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ]
      }
    },
    "proofNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "showHighlightsPanel": {
      "default": true,
      "type": "boolean"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "status",
    "summary"
  ]
}