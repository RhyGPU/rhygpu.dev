{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "hash",
          "title"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "number",
    "title",
    "slug",
    "project",
    "date",
    "summary"
  ]
}