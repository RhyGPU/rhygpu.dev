---
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact/', label: 'Contact' }
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<nav class="site-nav" aria-label="Primary">
  <div class="site-nav-inner">
    <a href="/" class="site-nav-logo" aria-label="RhyGPU home">
      <span class="site-nav-badge">R</span>
      <span class="site-nav-name">RhyGPU</span>
    </a>
    <div class="site-nav-links">
      {links.map((l) => (
        <a href={l.href} class:list={['site-nav-link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="https://github.com/RhyGPU" target="_blank" rel="noreferrer" class="site-nav-github">GitHub ↗</a>
    </div>
  </div>
</nav>
