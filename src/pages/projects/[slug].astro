---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasArchitecture = project.data.architecture.length > 0;
const hasMedia = project.data.media.length > 0 || project.data.demoLinks.length > 0;
const hasProofNotes = project.data.proofNotes.length > 0;
---
<BaseLayout title={`${project.data.title} | RhyGPU`} description={project.data.summary}>
  <div class="wrap">
    <a class="back" href="/projects/">Projects</a>

    <header class="project-hero">
      <div class="project-hero-heading">
        {project.data.icon && <img class="project-hero-icon" src={project.data.icon.src} alt={project.data.icon.alt} />}
        <div>
          <p class="kicker">Project</p>
          <h1 class="post-title">{project.data.title}</h1>
        </div>
      </div>
      {project.data.subtitle && <p class="post-subtitle">{project.data.subtitle}</p>}
      <div class="project-meta-row">
        <span class="status-pill">{project.data.status}</span>
        {project.data.repo && <a class="cta-link" href={project.data.repo}>GitHub</a>}
        {project.data.demo && <a class="cta-link" href={project.data.demo}>Demo</a>}
        {project.data.devlog && <a class="cta-link muted" href={project.data.devlog}>{project.data.devlogLabel ?? 'Devlogs'}</a>}
      </div>
      <ul class="stack-list hero-stack" aria-label={`${project.data.title} stack`}>
        {project.data.stack.map((item) => <li>{item}</li>)}
      </ul>
    </header>

    <main class="project-page">
      <section class="prose project-copy">
        <Content />
      </section>

      {project.data.showHighlightsPanel && project.data.highlights.length > 0 && (
        <section class="project-panel">
          <p class="section-label">Technical highlights</p>
          <ul class="highlight-list">
            {project.data.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {hasArchitecture && (
        <section class="project-panel">
          <p class="section-label">Architecture / System Shape</p>
          <div class="architecture-card" aria-label={`${project.data.title} architecture flow`}>
            {project.data.architecture.map((step) => <span>{step}</span>)}
          </div>
        </section>
      )}

      {hasMedia && (
        <section class="project-panel">
          <p class="section-label">Screenshots / Demo Proof</p>
          {project.data.demoLinks.length > 0 && (
            <div class="link-row proof-demo-links">
              {project.data.demoLinks.map((link) => (
                <a class="cta-link muted" href={link.url} title={link.caption}>{link.title}</a>
              ))}
            </div>
          )}
          {project.data.media.length > 0 && (
            <div class="media-grid">
              {project.data.media.map((item) => (
                <article class={`media-card ${item.status === 'planned' ? 'planned' : 'available'}`}>
                  <div class="media-frame">
                    {item.src ? (
                      <img src={item.src} alt={item.alt ?? item.title} loading="lazy" />
                    ) : (
                      <div class="media-placeholder">
                        <span>{item.type}</span>
                        <strong>{item.title}</strong>
                      </div>
                    )}
                  </div>
                  <div class="media-copy">
                    <div class="media-topline">
                      <h3>{item.title}</h3>
                      <span class={`proof-status ${item.status}`}>{item.status}</span>
                    </div>
                    <p>{item.caption}</p>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {hasProofNotes && (
        <section class="project-panel">
          <p class="section-label">Proof Notes</p>
          <ul class="proof-note-list">
            {project.data.proofNotes.map((note) => <li>{note}</li>)}
          </ul>
        </section>
      )}

      <section class="project-panel">
        <p class="section-label">Links</p>
        <div class="link-row">
          {project.data.repo && <a class="cta-link" href={project.data.repo}>Repository</a>}
          {project.data.devlog && <a class="cta-link muted" href={project.data.devlog}>{project.data.devlogLabel ?? 'Devlogs'}</a>}
          <a class="cta-link muted" href="/projects/">All projects</a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
