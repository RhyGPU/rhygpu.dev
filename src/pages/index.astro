---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const flagship = projects.find((p) => p.data.featured) ?? projects[0];
const secondary = projects.filter((p) => p.data.slug !== flagship.data.slug);

const devlogs = (await getCollection('devlogs'))
  .filter((post) => post.data.status === 'published')
  .sort((a, b) =>
    b.data.date.getTime() - a.data.date.getTime() ||
    Number(b.data.number) - Number(a.data.number)
  );

const latestDevlogs = devlogs.slice(0, 5);

const flagshipMedia = flagship.data.media?.find((m) => m.status === 'available' && m.src);

const statusDot = (status: string) => {
  const s = status.toLowerCase();
  if (s.includes('alpha') || s.includes('active')) return '#7cc98f';
  if (s.includes('prototype')) return '#5aabe6';
  return '#948d80';
};
---
<BaseLayout
  title="RhyGPU — Rhy's Systems Lab"
  description="A personal lab for AI tools, robotics systems, hardware experiments, devlogs, resumes, and long-term technical work."
>
  <div class="home-shell" id="top">

    <section class="home-hero">
      <p class="home-eyebrow">Rhy's Systems Lab</p>
      <h1 class="home-title">I build systems I can understand, inspect, and own.</h1>
      <div class="home-hero-bottom">
        <p class="home-tagline">A personal lab for AI tools, robotics systems, hardware experiments, devlogs, resumes, and long-term technical work.</p>
        <div class="home-cta-group">
          <a href="#projects" class="home-btn-primary">View projects</a>
          <a href="#devlog" class="home-btn-secondary">Read devlogs</a>
        </div>
      </div>
    </section>

    <div class="home-stats">
      <div class="home-stat">
        <div class="home-stat-value">{projects.length}</div>
        <div class="home-stat-label">active projects</div>
      </div>
      <div class="home-stat">
        <div class="home-stat-value">{devlogs.length}</div>
        <div class="home-stat-label">devlog entries</div>
      </div>
      <div class="home-stat">
        <div class="home-stat-value">Rust</div>
        <div class="home-stat-label">+ TS, C++, Electron</div>
      </div>
      <div class="home-stat">
        <div class="home-stat-value">Local</div>
        <div class="home-stat-label">first, always</div>
      </div>
    </div>

    <section id="projects" class="home-flagship">
      <p class="home-section-label">Featured — flagship</p>
      <article class="home-flagship-card">
        <a class="home-flagship-cover" href={`/projects/${flagship.data.slug}/`} aria-label={`Open ${flagship.data.title}`}></a>
        <div class="home-flagship-copy">
          <div class="home-flagship-badge">
            <span class="home-flagship-dot" style={`background:${statusDot(flagship.data.status)};box-shadow:0 0 10px ${statusDot(flagship.data.status)}`}></span>
            <span class="label" style={`color:${statusDot(flagship.data.status)}`}>{flagship.data.status.toUpperCase()}</span>
          </div>
          <h2 class="home-flagship-title">{flagship.data.title}</h2>
          <p class="home-flagship-desc">{flagship.data.summary}</p>
          <div class="home-tag-row">
            {flagship.data.stack.slice(0, 4).map((item) => <span class="home-tag">{item}</span>)}
          </div>
          <div class="home-flagship-links">
            {flagship.data.repo && <a class="gh" href={flagship.data.repo} target="_blank" rel="noreferrer">GitHub →</a>}
            <a class="dl" href={`/projects/${flagship.data.slug}/devlog/`}>Devlogs →</a>
          </div>
        </div>
        <div class="home-flagship-media">
          {flagshipMedia
            ? <img src={flagshipMedia.src} alt={flagshipMedia.alt ?? flagship.data.title} loading="lazy" />
            : <span class="home-flagship-placeholder">[ app screenshot ]</span>}
        </div>
      </article>
    </section>

    <div class="home-secondary-grid">
      {secondary.map((project) => (
        <article class="home-secondary-card">
          <a class="home-secondary-cover" href={`/projects/${project.data.slug}/`} aria-label={`Open ${project.data.title}`}></a>
          <div class="home-secondary-head">
            <h3>{project.data.title}</h3>
            <span class="home-secondary-badge">{project.data.status.toUpperCase()}</span>
          </div>
          <p class="home-secondary-desc">{project.data.summary}</p>
          <div class="home-secondary-tags">
            {project.data.stack.slice(0, 4).map((item) => <span class="home-secondary-tag">{item}</span>)}
          </div>
          <div class="home-secondary-links">
            {project.data.repo && <a class="home-secondary-link" href={project.data.repo} target="_blank" rel="noreferrer">GitHub →</a>}
            <a class="home-secondary-link" href={`/projects/${project.data.slug}/devlog/`}>Devlogs →</a>
          </div>
        </article>
      ))}
    </div>

    <div class="home-devlog-head" id="devlog">
      <h2>Latest devlogs</h2>
      <a href="/devlog/">Open full journal →</a>
    </div>
    <div class="home-devlog-list">
      {latestDevlogs.map((post) => (
        <a href={`/devlog/${post.data.slug}/`} class="home-devlog-row">
          <span class="home-devlog-n">{post.data.number}</span>
          <span class="home-devlog-titlewrap">
            <span class="home-devlog-title">{post.data.title}</span>
            <span class="home-devlog-tag">{post.data.project}</span>
          </span>
          <span class="home-devlog-blurb">{post.data.summary}</span>
          <span class="home-devlog-arrow">→</span>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
.home-shell { max-width: 1080px; margin: 0 auto; padding: 0 32px; }

.home-hero { padding: 76px 0 44px; }
.home-eyebrow { font: 600 12px var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--blue); margin-bottom: 22px; }
.home-title { font: 700 clamp(2.4rem, 6.4vw, 5.25rem)/.98 var(--display); letter-spacing: -.035em; margin: 0 0 26px; max-width: 900px; }
.home-hero-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
.home-tagline { font: 400 18px/1.6 var(--sans); color: var(--text-body); margin: 0; max-width: 540px; }
.home-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
.home-btn-primary { display: inline-flex; align-items: center; padding: 13px 24px; background: var(--blue); color: var(--bg); font: 600 14px var(--sans); border-radius: 8px; text-decoration: none; transition: background .16s, transform .16s; }
.home-btn-primary:hover { background: var(--blue-hover); transform: translateY(-1px); }
.home-btn-secondary { display: inline-flex; align-items: center; padding: 13px 24px; border: 1px solid var(--border-strong); color: var(--text); font: 500 14px var(--sans); border-radius: 8px; text-decoration: none; transition: border-color .16s, background .16s; }
.home-btn-secondary:hover { border-color: rgba(255,255,255,.4); background: rgba(255,255,255,.04); }

.home-stats { margin-top: 8px; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
.home-stat { padding: 18px 22px; border-right: 1px solid var(--border); }
.home-stat:last-child { border-right: 0; }
.home-stat-value { font: 700 26px var(--display); color: var(--blue); }
.home-stat-label { font: 400 12px var(--sans); color: var(--text-muted); }

.home-section-label { font: 600 12px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px; }

.home-flagship { padding: 64px 0 20px; scroll-margin-top: 80px; }
.home-flagship-card { position: relative; display: grid; grid-template-columns: 1.15fr 1fr; border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden; transition: border-color .18s; }
.home-flagship-card:hover { border-color: rgba(90,171,230,.35); }
.home-flagship-cover { position: absolute; inset: 0; z-index: 1; }
.home-flagship-cover:focus-visible { outline: 1px solid rgba(90,171,230,.55); outline-offset: -2px; }
.home-flagship-copy { position: relative; padding: 34px; }
.home-flagship-badge { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.home-flagship-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.home-flagship-badge .label { font: 600 11px var(--mono); letter-spacing: .06em; }
.home-flagship-title { font: 700 clamp(1.9rem, 4.4vw, 42px)/1 var(--display); letter-spacing: -.02em; margin: 0 0 14px; }
.home-flagship-desc { font: 400 15.5px/1.6 var(--sans); color: var(--text-body); margin: 0 0 22px; }
.home-tag-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 24px; }
.home-tag { font: 500 11px var(--mono); color: var(--text); background: rgba(255,255,255,.07); padding: 4px 10px; border-radius: 5px; }
.home-flagship-links { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 18px; font: 600 13px var(--sans); }
.home-flagship-links a.gh { color: var(--text-muted); text-decoration: none; transition: color .16s; }
.home-flagship-links a.gh:hover { color: var(--text); }
.home-flagship-links a.dl { color: var(--teal); text-decoration: none; transition: color .16s; }
.home-flagship-links a.dl:hover { color: #74cfc2; }
.home-flagship-media { border-left: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; min-height: 300px; background: repeating-linear-gradient(45deg, rgba(90,171,230,.10) 0 12px, rgba(90,171,230,.02) 12px 24px); }
.home-flagship-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.home-flagship-placeholder { font: 500 12px var(--mono); color: var(--text-dim); letter-spacing: .05em; }

.home-secondary-grid { padding: 8px 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.home-secondary-card { position: relative; border: 1px solid var(--border-strong); border-radius: 12px; padding: 26px; transition: border-color .18s, transform .18s; }
.home-secondary-card:hover { border-color: rgba(90,171,230,.35); transform: translateY(-2px); }
.home-secondary-cover { position: absolute; inset: 0; z-index: 1; }
.home-secondary-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.home-secondary-head h3 { font: 600 23px var(--display); margin: 0; color: var(--text); }
.home-secondary-badge { font: 600 10px var(--mono); color: var(--text-muted); letter-spacing: .05em; white-space: nowrap; }
.home-secondary-desc { font: 400 14px/1.55 var(--sans); color: var(--text-body); margin: 0 0 18px; }
.home-secondary-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
.home-secondary-tag { font: 500 10.5px var(--mono); color: var(--text-muted); border: 1px solid var(--border-strong); padding: 3px 8px; border-radius: 5px; }
.home-secondary-links { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 16px; }
.home-secondary-link { font: 600 12.5px var(--sans); color: var(--blue); text-decoration: none; transition: color .16s; }
.home-secondary-link:hover { color: var(--blue-hover); }

.home-devlog-head { padding: 48px 0 20px; scroll-margin-top: 80px; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.home-devlog-head h2 { font: 600 24px var(--display); margin: 0; color: var(--text); }
.home-devlog-head a { font: 600 13px var(--sans); color: var(--blue); text-decoration: none; transition: color .16s; }
.home-devlog-head a:hover { color: var(--blue-hover); }

.home-devlog-row { display: flex; gap: 20px; align-items: center; padding: 17px 12px; border-top: 1px solid var(--border); text-decoration: none; border-radius: 8px; transition: background .16s; }
.home-devlog-row:hover { background: rgba(255,255,255,.03); }
.home-devlog-n { font: 700 18px var(--display); color: var(--text-dim); flex: none; }
.home-devlog-titlewrap { display: flex; align-items: center; gap: 10px; width: 320px; flex: none; }
.home-devlog-title { font: 600 15px var(--sans); color: var(--text); }
.home-devlog-tag { font: 600 9px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); border: 1px solid var(--border-strong); border-radius: 4px; padding: 2px 5px; white-space: nowrap; }
.home-devlog-blurb { font: 400 13.5px/1.5 var(--sans); color: var(--text-muted); flex: 1; }
.home-devlog-arrow { font: 600 15px var(--sans); color: var(--teal); flex: none; }

@media (max-width: 860px) {
  .home-shell { padding: 0 20px; }
  .home-flagship-card { grid-template-columns: 1fr; }
  .home-flagship-media { min-height: 220px; border-left: 0; border-top: 1px solid var(--border-strong); }
  .home-secondary-grid { grid-template-columns: 1fr; }
  .home-stats { grid-template-columns: repeat(2, 1fr); }
  .home-stat:nth-child(2) { border-right: 0; }
  .home-devlog-row { flex-wrap: wrap; gap: 6px 20px; }
  .home-devlog-titlewrap { width: auto; min-width: 0; flex: 1 1 220px; flex-wrap: wrap; }
  .home-devlog-title { min-width: 0; }
  .home-devlog-blurb { flex-basis: 100%; }
}
</style>
